{
  "manifest_version": 2,
  "name": "Address Bar Search",
  "version": "1.0",
  "description": "Supplies a default search engine. Camoufox strips the bundled ones, so without this the address bar cannot search.",
  "browser_specific_settings": {
    "gecko": {
      "id": "search@kiwi-fox",
      "strict_min_version": "115.0"
    }
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "DuckDuckGo",
      "search_url": "https://duckduckgo.com/?q={searchTerms}",
      "suggest_url": "https://duckduckgo.com/ac/?q={searchTerms}&type=list",
      "keyword": "ddg",
      "is_default": true
    }
  }
}
